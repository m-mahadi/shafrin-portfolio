---
// Artboard 11. Only the ULAB address is published. The social row stays a
// labelled placeholder until handles are supplied.
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base
  title="Contact"
  description="Get in touch with Shafrin Akter Chowdhury about reporting work, research assistance and communication for development roles."
>
  <section class="wrap contact">
    <div class="contact__copy">
      <p class="kicker">§ Contact</p>
      <h1 class="display">Say hello, or<br /><em class="pink">send me a story.</em></h1>
      <p>
        Open to reporting work, research assistance and communication for development roles. If you
        are working on something in Dhaka that deserves attention, I would like to hear about it.
      </p>

      <dl class="channels">
        <div>
          <dt>Email</dt>
          <dd class="channels__email-row">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <button
              type="button"
              class="copy-btn"
              id="copy-email-btn"
              data-email={site.email}
              aria-label="Copy email address to clipboard"
            >
              <span id="copy-btn-text">Copy</span>
            </button>
            <span class="visually-hidden" id="copy-status" aria-live="polite"></span>
          </dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={`tel:${site.phone}`}>{site.phoneLabel}</a></dd>
        </div>
        <div>
          <dt>Blog</dt>
          <dd><a href={site.blog} rel="noopener">{site.blogLabel} ↗</a></dd>
        </div>
        <div>
          <dt>Social</dt>
          <dd><a href={site.linkedin} rel="noopener">LinkedIn ↗</a></dd>
        </div>
        <div>
          <dt>Résumé</dt>
          <dd><a href={site.resume}>Download PDF ↗</a></dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd class="plain">{site.location}</dd>
        </div>
      </dl>
    </div>

    <div class="contact__form">
      <div class="frame__shadow" aria-hidden="true"></div>
      <form id="contact-form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <h2>Write to me</h2>
        <p>I reply to everything that is not a mailing list.</p>

        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field field--accent">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="What are you working on?" required></textarea>
        </div>

        <div class="form-foot">
          <button type="submit" id="contact-submit">Send message</button>
          <span>Usually a reply within a few days.</span>
        </div>
      </form>
    </div>
  </section>

  <script>
    // Copy email button with accessible announcement and robust fallback
    const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    const copyText = document.getElementById('copy-btn-text');
    const copyStatus = document.getElementById('copy-status');

    if (copyBtn && copyText && copyStatus) {
      const email = copyBtn.dataset.email || '';
      let resetTimer: number | undefined;

      copyBtn.addEventListener('click', async () => {
        let copied = false;
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try {
            await navigator.clipboard.writeText(email);
            copied = true;
          } catch {
            copied = false;
          }
        }

        if (!copied) {
          try {
            const textarea = document.createElement('textarea');
            textarea.value = email;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            textarea.style.top = '-9999px';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            copied = document.execCommand('copy');
            document.body.removeChild(textarea);
            copyBtn.focus();
          } catch {
            copied = false;
          }
        }

        window.clearTimeout(resetTimer);

        if (copied) {
          copyText.textContent = 'Copied!';
          copyBtn.setAttribute('data-copied', 'true');
          copyStatus.textContent = 'Email address copied to clipboard.';
          resetTimer = window.setTimeout(() => {
            copyText.textContent = 'Copy';
            copyBtn.removeAttribute('data-copied');
            copyStatus.textContent = '';
          }, 2000);
        } else {
          copyStatus.textContent = `Could not copy automatically. Email is ${email}`;
        }
      });
    }

    // Form submit: native validation & mailto URL construction with proper encoding
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (event) => {
        if (!form.checkValidity()) {
          form.reportValidity();
          event.preventDefault();
          return;
        }

        event.preventDefault();
        const nameInput = form.querySelector<HTMLInputElement>('#name');
        const emailInput = form.querySelector<HTMLInputElement>('#email');
        const messageInput = form.querySelector<HTMLTextAreaElement>('#message');

        const name = nameInput?.value.trim() || '';
        const senderEmail = emailInput?.value.trim() || '';
        const message = messageInput?.value.trim() || '';

        const subject = `Portfolio message from ${name}`;
        const body = `From: ${name} <${senderEmail}>\n\n${message}`;

        const recipient = form.action.replace(/^mailto:/i, '').split('?')[0] || '';
        const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        window.location.href = mailtoUrl;
      });
    }
  </script>
</Base>
