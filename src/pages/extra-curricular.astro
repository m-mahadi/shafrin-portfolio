---
// Artboard 09. Filled with Shafrin's real campus activities: the three
// certificated activities plus her ULAB TV campus-television reporting.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import ArrowLink from '../components/ArrowLink.astro';
import rongChong from '../assets/images/rongchong-01.jpg';
import certDst from '../assets/images/cert-dst.jpg';
import certEarthDay from '../assets/images/cert-earthday.jpg';

const activities = [
  {
    image: rongChong,
    alt: 'Shafrin Akter Chowdhury painting alpona on a campus road during Rong Chong 2.0.',
    meta: 'Volunteer painter · ULAB · September 2023',
    title: 'Rong Chong 2.0',
    body:
      'Rong Chong 2.0 was a four-day painting event on campus, and I spent all four days on the ground with a brush. We turned the road into alpona, colour laid down by hand, one panel at a time. It taught me something the coursework did not: a public space changes the way people move through it, and giving a place colour is its own quiet way of speaking to everyone who walks past.',
    href: '/pdf/rong-chong-2.0-certificate.pdf',
    linkLabel: 'View certificate',
    linkAria: 'View the Rong Chong 2.0 certificate (PDF)',
  },
  {
    image: certDst,
    alt: 'Digital Security Training certificate awarded to Shafrin Akter Chowdhury.',
    meta: 'Participant · Asia Centre with GED, ULAB · November 2025',
    title: 'Digital Security Training',
    body:
      "I took part in the Digital Security Training run by Asia Centre with ULAB's General Education department, supported by Google. For anyone who wants to report on sensitive subjects, protecting your sources, your accounts and yourself online is not a side skill. The training changed how carefully I handle information now: before a story, during it, and after it is published.",
    href: '/pdf/digital-security-training-certificate.pdf',
    linkLabel: 'View certificate',
    linkAria: 'View the Digital Security Training certificate (PDF)',
  },
  {
    image: certEarthDay,
    alt: 'Planet Pulse Quiz certificate of excellence awarded to Shafrin Akter Chowdhury.',
    meta: 'Certificate of excellence · Earth Day, ULAB · April 2026',
    title: 'Planet Pulse Quiz',
    body:
      "During ULAB's Earth Day celebration I took part in the Planet Pulse Quiz on the environment and sustainable development, and was given a certificate of excellence. Environmental questions run through a lot of my work, from air pollution to waste to the image of a city, so the quiz was a way to test how much of it I actually carry with me rather than only write about.",
    href: '/pdf/planet-pulse-earth-day-certificate.pdf',
    linkLabel: 'View certificate',
    linkAria: 'View the Planet Pulse Quiz certificate (PDF)',
  },
];
---

<Base
  title="Extra Curricular"
  description="Clubs, campus media, volunteering and workshops alongside the coursework at ULAB."
>
  <section class="wrap page-head">
    <div class="page-head__title">
      <p class="kicker">§ Extra Curricular</p>
      <h1 class="display">Outside the<br /><em>syllabus.</em></h1>
    </div>
    <p class="page-head__aside">
      Clubs, campus media, volunteering and workshops that sat alongside the coursework. Alongside
      these I am a general member of ULAB's Art and Photography, Adventure and Debating clubs.
    </p>
  </section>

  <div class="wrap" style="padding-bottom: 110px;">
    {activities.map((a, i) => (
      <article class:list={['activity', i === 1 && 'activity--flip']}>
        <Frame class="activity__image" offset={14}>
          <Image
            src={a.image}
            alt={a.alt}
            widths={[472, 944]}
            sizes="(max-width: 767px) 100vw, 472px"
          />
        </Frame>
        <div class="activity__copy">
          <p class="plate-head">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="eyebrow">{a.meta}</span>
          </p>
          <h2>{a.title}</h2>
          <p>{a.body}</p>
          <ArrowLink href={a.href} label={a.linkLabel} arrow={false} ariaLabel={a.linkAria} />
        </div>
      </article>
    ))}
  </div>

  <section class="wrap oncamera" aria-labelledby="on-camera" style="padding-bottom: 110px;">
    <div class="rule-head">
      <div class="rule-head__left">
        <h2 class="kicker" id="on-camera">§ On camera</h2>
        <p class="section-note">ULAB TV.</p>
      </div>
      <p class="rule-head__meta">Campus television</p>
    </div>
    <p class="oncamera__intro">
      I report for ULAB TV, the department's campus television. This master class on the film crew,
      organised by DIMFF, the Dhaka International Mobile Film Festival, is the kind of story we cover:
      sitting in the room, listening, and turning an afternoon of craft into a few clean minutes an
      audience can follow.
    </p>
    <div class="oncamera__frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/Nfh6B6_kYLo"
        title="Master class on the film crew — ULAB TV"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</Base>

<style>
  .oncamera__intro {
    max-width: 760px;
    padding-top: 26px;
    font-size: var(--text-lead);
    font-weight: 400;
    line-height: 34px;
  }
  .oncamera__frame {
    position: relative;
    margin-top: 34px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
  }
  .oncamera__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 767px) {
    .oncamera__intro {
      padding-top: 18px;
    }
    .oncamera__frame {
      margin-top: 24px;
    }
  }
</style>
