---
import { nav, menuNav, site } from '../lib/site';
import { allProjects, href as projectHref, isBengali } from '../lib/projects';

interface Props {
  path: string;
}
const { path } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const projects = await allProjects();
---

<header class="site-header">
  <div class="riso" aria-hidden="true"></div>
  <div class="wrap">
    <div class="nav">
      <p class="wordmark">
        <a class="wordmark__name" href="/">{site.name}</a>
        <span class="wordmark__tag">{site.tagline}</span>
      </p>

      <nav class="nav__links" aria-label="Primary">
        {nav.map((item) => (
          item.href === '/portfolio' ? (
            <span class="nav__dd">
              <a href="/portfolio" aria-haspopup="true" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              <div class="nav__dd-panel">
                <a class="nav__dd-all" href="/portfolio">View all projects</a>
                {projects.map((p) => (
                  <a
                    class:list={['nav__dd-item', isBengali(p.data.title) && 'bn']}
                    href={projectHref(p)}
                    aria-current={path === projectHref(p) ? 'page' : undefined}
                  >
                    <span class="nav__dd-num" aria-hidden="true">{p.data.number}</span>
                    {p.data.title}
                  </a>
                ))}
              </div>
            </span>
          ) : (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          )
        ))}
      </nav>

      <button
        class="nav__toggle"
        type="button"
        id="menu-open"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        Menu
        <svg width="20" height="12" viewBox="0 0 20 12" aria-hidden="true" focusable="false">
          <path d="M0 1h20M0 11h20" fill="none" stroke="var(--color-pink)" stroke-width="1.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" hidden>
  <div class="menu__bar">
    <strong>{site.name}</strong>
    <button class="menu__close" type="button" id="menu-close" aria-label="Close menu">
      Close
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M1 1l14 14M15 1L1 15" fill="none" stroke="var(--color-pink)" stroke-width="1.4"></path>
      </svg>
    </button>
  </div>

  <nav class="menu__list" aria-label="Site menu">
    {menuNav.map((item, index) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        <span class="menu__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="menu__label">{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="menu__foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <small>{site.department}</small>
  </div>
</div>

<script>
  const openButton = document.getElementById('menu-open') as HTMLButtonElement | null;
  const closeButton = document.getElementById('menu-close') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;

  if (openButton && closeButton && menu) {
    let lastActiveElement: HTMLElement | null = null;
    let savedHtmlOverflow = '';
    let savedBodyOverflow = '';

    const focusables = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null || el === closeButton);

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    function open() {
      if (menu.classList.contains('is-open')) return;
      lastActiveElement = (document.activeElement as HTMLElement) || openButton;
      menu.hidden = false;
      menu.setAttribute('aria-hidden', 'false');
      menu.classList.add('is-open');
      openButton.setAttribute('aria-expanded', 'true');

      savedHtmlOverflow = document.documentElement.style.overflow;
      savedBodyOverflow = document.body.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      document.addEventListener('keydown', onKeydown);
      closeButton.focus();
    }

    function close(restoreFocus = true) {
      if (!menu.classList.contains('is-open') && menu.hidden) return;
      menu.classList.remove('is-open');
      menu.hidden = true;
      menu.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');

      document.documentElement.style.overflow = savedHtmlOverflow;
      document.body.style.overflow = savedBodyOverflow;

      document.removeEventListener('keydown', onKeydown);

      if (restoreFocus && lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      } else if (restoreFocus && openButton) {
        openButton.focus();
      }
    }

    openButton.addEventListener('click', open);
    closeButton.addEventListener('click', () => close(true));

    // Link-click dismissal: any link inside the sheet navigates & dismisses
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        close(false);
      });
    });

    // Backdrop click: dismiss if user clicks the modal container itself
    menu.addEventListener('click', (event) => {
      if (event.target === menu) {
        close(true);
      }
    });

    // Viewport resize cleanup: if window widens to desktop, close menu
    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches && !menu.hidden) close(false);
    });

    // BFCache / pageshow cleanup
    window.addEventListener('pageshow', (event) => {
      if (event.persisted || menu.classList.contains('is-open')) {
        close(false);
      }
    });
  }
</script>

<style>
  /* Portfolio dropdown: hovering or focusing the Portfolio item reveals the
     full project index as a compact two-column plate; the label itself still
     links to /portfolio. */
  /* The panel is anchored to the nav's right edge so it stays inside the
     content column at any desktop width. */
  .nav { position: relative; }
  .nav__dd { position: static; display: inline-flex; }
  .nav__dd-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: auto;
    margin-top: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 34px;
    width: min(588px, 92vw);
    padding: 20px 26px 22px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink);
    box-shadow: 10px 10px 0 var(--color-pink-wash);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(5px);
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 60;
  }
  /* Invisible bridge across the gap so moving from the label to the panel
     never drops the hover and the menu can actually be clicked. */
  .nav__dd-panel::before {
    content: '';
    position: absolute;
    top: -16px;
    left: 0;
    right: 0;
    height: 16px;
  }
  .nav__dd:hover .nav__dd-panel,
  .nav__dd:focus-within .nav__dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .nav__dd-all {
    grid-column: 1 / -1;
    margin-bottom: 12px;
    padding: 0 0 12px !important;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono), monospace !important;
    font-size: 11px !important;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-oxblood) !important;
  }
  .nav__dd-panel a {
    display: flex;
    align-items: baseline;
    gap: 13px;
    padding: 7px 0;
    font-family: var(--font-display), Georgia, serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
    border-bottom: 0;
    transition: color 0.14s ease;
  }
  .nav__dd-item { border-top: 1px solid var(--color-rule); }
  .nav__dd-panel a:hover,
  .nav__dd-panel a:focus-visible { color: var(--color-pink); }
  .nav__dd-num {
    flex-shrink: 0;
    width: 20px;
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-pink);
  }
  .nav__dd-item.bn {
    font-family: var(--font-bangla), var(--font-display), serif;
    font-size: 14px;
    line-height: 20px;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__dd-panel { transition: none; transform: translateY(0); }
  }
</style>
